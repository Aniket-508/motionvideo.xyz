{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motionvideo",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  // Non-secret production config. `.env` overrides these locally.
  // Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, POLAR_*) are set with `wrangler secret put`.
  "vars": {
    "BETTER_AUTH_URL": "https://motionvideo.xyz",
    "EMAIL_FROM": "motionvideo <hello@motionvideo.xyz>",
    "POLAR_SERVER": "production",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motionvideo",
      // Replace with the id printed by `pnpm wrangler d1 create motionvideo`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
}
