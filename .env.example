# Copy to `.env` for local development (`cp .env.example .env`).
# In production, set secrets with `pnpm wrangler secret put <NAME>`.

BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Leave empty in development to print magic links to the dev server console.
RESEND_API_KEY=
EMAIL_FROM="motionvideo <onboarding@resend.dev>"

# "production" (live) or "sandbox" (test org at sandbox.polar.sh).
POLAR_SERVER=production
# Organization access token from Polar → Settings → Developers.
POLAR_ACCESS_TOKEN=
# Signing secret of the Polar webhook endpoint (/api/webhook/polar).
POLAR_WEBHOOK_SECRET=
# The next two are printed by `pnpm polar:setup`.
POLAR_PRODUCT_ID=
# JSON map of PPP discount percent → Polar discount id.
POLAR_PPP_DISCOUNTS={}

# Development only: pretend requests come from this country (e.g. IN) to test PPP.
DEV_COUNTRY=
