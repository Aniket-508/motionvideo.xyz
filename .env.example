# Copy to `.env` for local development (`cp .env.example .env`).
# In production, set secrets with `pnpm wrangler secret put <NAME>`.

BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Leave empty in development to print emails to the dev server console.
RESEND_API_KEY=
EMAIL_FROM='"Aniket @ MotionVideo" <hello@motionvideo.xyz>'

# "production" (live) or "sandbox" (test org at sandbox.polar.sh).
POLAR_SERVER=production
# Organization access token from Polar → Settings → Developers.
POLAR_ACCESS_TOKEN=
# Signing secret of the Polar webhook endpoint (/api/webhook/polar).
POLAR_WEBHOOK_SECRET=
# Preorder setup (already created in Polar): the prior product retains its
# existing buyers and GitHub benefit; the new product has none before launch.
POLAR_LEGACY_PRODUCT_ID=
POLAR_PRODUCT_ID=
POLAR_LAUNCH_DISCOUNT_ID=
